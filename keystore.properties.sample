# Copy to keystore.properties (NEVER commit) and fill in.
# Generate a keystore locally with:
#   keytool -genkeypair -v -keystore mecrc-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias mecrc
storeFile=/absolute/path/to/mecrc-release.jks
storePassword=CHANGE_ME
keyAlias=mecrc
keyPassword=CHANGE_ME
