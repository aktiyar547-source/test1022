name: Emulator Smoke Test

# Boots a real Android emulator, installs the app, launches it, and captures
# screenshots — proof the app actually RUNS (not just compiles).
# Kept in its own workflow so a failure here can never break the main build.

on:
  push:
    branches: [ main ]
  workflow_dispatch:        # run on demand from the Actions tab

jobs:
  smoke-test:
    runs-on: ubuntu-latest
    timeout-minutes: 40

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Ensure Gradle wrapper
        run: gradle wrapper --gradle-version 8.9

      # Hardware acceleration — without this the emulator is unusably slow.
      - name: Enable KVM
        run: |
          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' \
            | sudo tee /etc/udev/rules.d/99-kvm4all.rules
          sudo udevadm control --reload-rules
          sudo udevadm trigger --name-match=kvm

      - name: Build debug APK
        run: ./gradlew assembleDevDebug

      - name: Launch emulator and capture screenshots
        uses: reactivecircus/android-emulator-runner@v2
        with:
          api-level: 29          # Android 10 == the app's minSdk
          target: google_apis
          arch: x86_64
          profile: pixel_2
          disable-animations: true
          emulator-options: -no-window -gpu swiftshader_indirect -noaudio -no-boot-anim -camera-back emulated
          script: |
            set -x
            mkdir -p artifacts

            APP_ID=com.middleeastcontainer.dev.debug
            ACTIVITY=$APP_ID/com.middleeastcontainer.ui.MainActivity

            adb install -r app/build/outputs/apk/dev/debug/app-dev-debug.apk

            # Grant camera up front so the permission dialog doesn't hide the UI.
            adb shell pm grant $APP_ID android.permission.CAMERA || true

            adb logcat -c
            adb shell am start -n $ACTIVITY
            sleep 12

            # 1) Login screen
            adb exec-out screencap -p > artifacts/01_login.png

            # Type a username and save -> should navigate to the Menu.
            adb shell input tap 540 620
            adb shell input text "inspector1"
            sleep 1
            adb exec-out screencap -p > artifacts/02_login_filled.png
            adb shell input keyevent 111        # dismiss keyboard (ESC)
            sleep 1
            adb shell input tap 540 900         # Save button
            sleep 6

            # 2) Menu screen
            adb exec-out screencap -p > artifacts/03_menu.png

            # Crash check: the process must still be alive.
            PID=$(adb shell pidof $APP_ID | tr -d '\r')
            echo "PID after launch: '$PID'"

            adb logcat -d > artifacts/logcat.txt
            adb logcat -d -b crash > artifacts/crash.txt || true

            if [ -z "$PID" ]; then
              echo "::error::App is NOT running - it crashed or failed to start."
              tail -n 120 artifacts/crash.txt || true
              exit 1
            fi
            echo "App is running. Smoke test passed."

      - name: Upload screenshots and logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: emulator-screenshots
          path: artifacts/
          if-no-files-found: warn
